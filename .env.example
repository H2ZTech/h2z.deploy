# Run node scripts/init.mjs to create .env and private credentials.
HTTP_BIND=127.0.0.1
HTTP_PORT=8096
MQTT_BIND=127.0.0.1
MQTT_PORT=1896
EMQX_DASHBOARD_PORT=18096
RTSP_PORT=8596
RTMP_PORT=1996
AI_WEB_PORT=3096
AI_WEB_HOST_PORT=3096
# Set to 0.0.0.0 to let the site LAN open DSH at http://<board IP>:3096/ (sign in with
# secrets/dsh-web/password). Keep 127.0.0.1 for SSH-tunnel-only access.
AI_WEB_BIND=127.0.0.1
# Empty = all private ranges (10/8, 172.16/12, 192.168/16) plus the Tailscale range 100.64/10.
DSH_LAN_NETWORKS=
# Optional stable names for DSH, e.g. orangepi5-max.local (cookie survives DHCP changes).
DSH_TRUSTED_NAMES=
# DSH file sandbox. Leave empty where the kernel has Landlock (Windows Docker Desktop/WSL2).
# init.sh sets danger-full-access automatically when the kernel has no Landlock (Orange Pi vendor
# kernels); see docs/ORANGE-PI.md.
DSH_SANDBOX_MODE=
NODERED_PORT=1897
POSTGRES_USER=security
POSTGRES_DB=security
POSTGRES_PASSWORD=
MQTT_USERNAME=security
MQTT_PASSWORD=
EMQX_PASSWORD=
EMQX_COOKIE=
ZLM_SECRET=
ZLM_HOOK_SECRET=
BACKEND_IMAGE=ghcr.io/h2ztech/h2z-backend:latest
FRONTEND_IMAGE=ghcr.io/h2ztech/h2z-ioc-frontend:latest
AI_IMAGE=ghcr.io/h2ztech/h2z-ai-server:latest
NODERED_IMAGE=ghcr.io/h2ztech/h2z-nodered:latest
POSTGRES_IMAGE=postgres:16-alpine
EMQX_IMAGE=emqx/emqx:5.8.8
ZLM_IMAGE=zlmediakit/zlmediakit:master
# x86 核显（VAAPI）转码用的 ZLM 薄镜像（官方镜像 + 显卡驱动；compose.zlm-vaapi.yaml）。机器有 /dev/dri 且本机有这个镜像才启用，否则仍用上面的官方镜像。在线更新的发布清单从这里取镜像，所以要写在这里
ZLM_VAAPI_IMAGE=ghcr.io/h2ztech/zlm-x86:latest
# 多架构（amd64 + arm64，Orange Pi 也能起）；旧的 3.3.2.0 标签只有 amd64
TDENGINE_IMAGE=ghcr.io/h2ztech/tdengine:3.3.2.0-multiarch
# SiteOps 录像机（--profile recorder）。块池目录不填用命名卷；NAS 托管模式填存储卷上的目录，例如 /vol1/h2z-pool
RECORDER_IMAGE=ghcr.io/h2ztech/h2z-recorder:latest
RECORDER_POOL_DIR=
# 本地录像机容量由界面设置（录像 → 本地录像机 → 存储情况）；这里只是没设时的默认值，空 = 等界面设
RECORDER_POOL_GB=
RECORDER_BLOCK_MB=128
# 磁盘至少留给系统 max(比例, GB)
RECORDER_RESERVE_PCT=15
RECORDER_RESERVE_MIN_GB=10
# 现场 NTP 服务器（测主机时钟偏差用，不改主机时间；空 = 只看主机有没有同步）
RECORDER_NTP_SERVER=
# 空间运动索引写进 TDengine 的现场编号（字母数字，≤ 32 字）
RECORDER_SITE=site
YOLO_IMAGE=h2z-security/yolo:0.1.0
YOLO_MODE=disabled
YOLO_MODEL=/models/yolov8n.pt
VIDEO_DECODER=h264
INFERENCE_FPS=3
H2Z_LOOP_DRY_RUN=0
# Leave empty: the default exploration scope follows the board's current network (host-network
# service). Set CIDRs only to override it for every task.
IOC_NETWORK_SCOPE=
# Remote access (Tailscale, part of the default stack). Log in from IOC admin → 设备网络, or put a
# one-time auth key here (keep only in the ignored, mode-0600 .env file).
TAILSCALE_IMAGE=tailscale/tailscale:stable
# Empty = the board's hostname.
TAILSCALE_HOSTNAME=
TS_AUTHKEY=
# Maintenance WiFi hotspot network (host/setup-host-network.sh); excluded from exploration.
MAINT_AP_NETWORK=192.168.234.0/24
HOST_AGENT_IMAGE=node:22-bookworm-slim
# h2z-backend 默认管理员口令（只在用户表为空时创建；老站点已有 admin）：留空 = h2z2026，交付时填写
H2Z_ADMIN_PASSWORD=
