# Rendered by host/setup-host-network.sh -> /etc/h2z/hostapd-maint.conf (mode 0600).
interface=@AP_IF@
driver=nl80211
ssid=@AP_SSID@
hw_mode=g
channel=@AP_CHANNEL@
ieee80211n=1
wmm_enabled=1
auth_algs=1
ignore_broadcast_ssid=0
ap_isolate=1
max_num_sta=8
wpa=2
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
wpa_passphrase=@AP_PSK@
