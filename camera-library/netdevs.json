  "snmp": {
    "note": "Standard tables every family below is asked first. A device that does not answer one simply lacks it.",
    "evidence": "documented",
    "sources": [
      "ietf-mibs"
    ],
    "tables": [
      {
        "id": "sysDescr",
        "oid": "1.3.6.1.2.1.1.1.0",
        "gives": "platform, software version and usually the model"
      },
      {
        "id": "sysObjectID",
        "oid": "1.3.6.1.2.1.1.2.0",
        "gives": "vendor (enterprise number) and product"
      },
      {
        "id": "sysName",
        "oid": "1.3.6.1.2.1.1.5.0",
        "gives": "configured device name"
      },
      {
        "id": "sysLocation",
        "oid": "1.3.6.1.2.1.1.6.0",
        "gives": "configured location (cabinet, room)"
      },
      {
        "id": "ifDescr",
        "oid": "1.3.6.1.2.1.2.2.1.2",
        "gives": "interface names by ifIndex"
      },
      {
        "id": "ifOperStatus",
        "oid": "1.3.6.1.2.1.2.2.1.8",
        "gives": "link up (1) / down (2)"
      },
      {
        "id": "ifPhysAddress",
        "oid": "1.3.6.1.2.1.2.2.1.6",
        "gives": "interface MAC"
      },
      {
        "id": "ifHighSpeed",
        "oid": "1.3.6.1.2.1.31.1.1.1.15",
        "gives": "negotiated speed in Mbps"
      },
      {
        "id": "ifAlias",
        "oid": "1.3.6.1.2.1.31.1.1.1.18",
        "gives": "port description written by the installer (often the far end)"
      },
      {
        "id": "dot3StatsDuplexStatus",
        "oid": "1.3.6.1.2.1.10.7.2.1.19",
        "gives": "duplex: half (2) / full (3)"
      },
      {
        "id": "dot1dBasePortIfIndex",
        "oid": "1.3.6.1.2.1.17.1.4.1.2",
        "gives": "bridge port number to ifIndex (needed to read the FDB)"
      },
      {
        "id": "dot1dTpFdbPort",
        "oid": "1.3.6.1.2.1.17.4.3.1.2",
        "gives": "MAC to bridge port, VLAN-unaware devices"
      },
      {
        "id": "dot1qTpFdbPort",
        "oid": "1.3.6.1.2.1.17.7.1.2.2.1.2",
        "gives": "VLAN + MAC to bridge port"
      },
      {
        "id": "dot1qPvid",
        "oid": "1.3.6.1.2.1.17.7.1.4.5.1.1",
        "gives": "access VLAN per port"
      },
      {
        "id": "dot1qVlanStaticName",
        "oid": "1.3.6.1.2.1.17.7.1.4.3.1.1",
        "gives": "VLAN names"
      },
      {
        "id": "ipNetToMediaPhysAddress",
        "oid": "1.3.6.1.2.1.4.22.1.2",
        "gives": "ARP table: IP to MAC (complete only on the layer-3 gateway)"
      },
      {
        "id": "lldpLocPortId",
        "oid": "1.0.8802.1.1.2.1.3.7.1.3",
        "gives": "local port names by LLDP port number"
      },
      {
        "id": "lldpRemChassisId",
        "oid": "1.0.8802.1.1.2.1.4.1.1.5",
        "gives": "neighbour chassis id (usually its MAC)"
      },
      {
        "id": "lldpRemPortId",
        "oid": "1.0.8802.1.1.2.1.4.1.1.7",
        "gives": "neighbour port"
      },
      {
        "id": "lldpRemSysName",
        "oid": "1.0.8802.1.1.2.1.4.1.1.9",
        "gives": "neighbour name"
      },
      {
        "id": "lldpRemSysDesc",
        "oid": "1.0.8802.1.1.2.1.4.1.1.10",
        "gives": "neighbour platform"
      },
      {
        "id": "lldpRemManAddr",
        "oid": "1.0.8802.1.1.2.1.4.2.1.4",
        "gives": "neighbour management address"
      },
      {
        "id": "entPhysicalSerialNum",
        "oid": "1.3.6.1.2.1.47.1.1.1.1.11",
        "gives": "serial numbers (one per stack member)"
      },
      {
        "id": "entPhysicalModelName",
        "oid": "1.3.6.1.2.1.47.1.1.1.1.13",
        "gives": "hardware model"
      },
      {
        "id": "pethPsePortDetectionStatus",
        "oid": "1.3.6.1.2.1.105.1.1.1.6",
        "gives": "PoE per port: delivering (3) / searching (2)"
      },
      {
        "id": "pethMainPseConsumptionPower",
        "oid": "1.3.6.1.2.1.105.1.3.1.1.4",
        "gives": "PoE watts in use; budget is ...1.1.2"
      },
      {
        "id": "upsEstimatedChargeRemaining",
        "oid": "1.3.6.1.2.1.33.1.2.4.0",
        "gives": "UPS battery percent; minutes left is ...2.3.0"
      }
    ]
  },
  "linkRules": [
    "An LLDP neighbour read from the device itself is a confirmed link, with both port names.",
    "A MAC seen on an access port (FDB) plus the ARP table of the gateway places an end device on that port: inferred, not confirmed.",
    "A port whose FDB holds many MACs is an uplink or carries another switch / AP: do not place those MACs on it as directly attached.",
    "Access points advertise themselves over LLDP; the switch side tells which port they are on. Wireless clients come from the controller, or from the AP's own FDB.",
    "No answer is 'unknown', not 'down'."
  ],
