  "families": [
    {
      "id": "hikvision-isapi",
      "name": "Hikvision ISAPI",
      "productSupport": "supported",
      "vendors": [
        "hikvision",
        "hilook",
        "annke"
      ],
      "identify": {
        "tcpPorts": [
          80,
          554,
          8000
        ],
        "http": {
          "method": "GET",
          "path": "/ISAPI/System/deviceInfo",
          "expect": "XML <DeviceInfo> with <deviceType> NVR / DVR / HybirdNVR",
          "expectContains": "<deviceType>"
        },
        "evidence": "verified"
      },
      "auth": {
        "http": "digest",
        "rtsp": "digest",
        "lockout": "repeated wrong passwords lock the account: stop after the first 401"
      },
      "time": {
        "zone": "device-local",
        "note": "search and playback times are the recorder's wall clock written with a trailing Z; read /ISAPI/System/time and correct for the offset",
        "evidence": "verified"
      },
      "channelBase": 1,
      "interfaces": {
        "deviceInfo": {
          "method": "GET",
          "path": "/ISAPI/System/deviceInfo",
          "evidence": "verified"
        },
        "clock": {
          "method": "GET",
          "path": "/ISAPI/System/time",
          "evidence": "verified"
        },
        "channels": {
          "method": "GET",
          "path": "/ISAPI/ContentMgmt/InputProxy/channels",
          "status": "/ISAPI/ContentMgmt/InputProxy/channels/status",
          "evidence": "verified"
        },
        "recordTracks": {
          "method": "GET",
          "path": "/ISAPI/ContentMgmt/record/tracks",
          "evidence": "verified"
        },
        "search": {
          "method": "POST",
          "path": "/ISAPI/ContentMgmt/search",
          "body": "CMSearchDescription XML; trackID = channel*100 + (1 main | 2 sub); paged with searchResultPostion, status MORE / OK / NO MATCHES",
          "evidence": "verified"
        },
        "storage": {
          "method": "GET",
          "path": "/ISAPI/ContentMgmt/Storage",
          "evidence": "verified"
        },
        "download": {
          "method": "GET",
          "path": "/ISAPI/ContentMgmt/download",
          "body": "downloadRequest XML with the playbackURI; some firmware wants POST",
          "evidence": "verified"
        }
      },
      "rtsp": {
        "port": 554,
        "live": {
          "main": "/Streaming/Channels/{ch}01",
          "sub": "/Streaming/Channels/{ch}02",
          "evidence": "verified"
        },
        "playback": {
          "template": "/Streaming/tracks/{ch}0{stream}/?starttime={start}&endtime={end}",
          "stream": {
            "main": "1",
            "sub": "2"
          },
          "timeFormat": "YYYYMMDDThhmmssZ",
          "scale": "RTSP Scale header, 1/2/4/8x",
          "evidence": "verified"
        }
      },
      "limits": [
        "searching the sub-stream track returns playback URIs that still name the main track: rewrite the track number"
      ],
      "sources": [
        "h2z-la31",
        "h2z-backend-isapi"
      ]
    },
    {
      "id": "dahua-cgi",
      "name": "Dahua HTTP API (CGI)",
      "productSupport": "none",
      "vendors": [
        "dahua",
        "amcrest",
        "lorex"
      ],
      "identify": {
        "tcpPorts": [
          80,
          554,
          37777
        ],
        "http": {
          "method": "GET",
          "path": "/cgi-bin/magicBox.cgi?action=getDeviceType",
          "expect": "text 'type=<model or NVR/DVR>'",
          "expectContains": "type="
        },
        "evidence": "documented"
      },
      "auth": {
        "http": "digest",
        "rtsp": "digest"
      },
      "time": {
        "zone": "device-local",
        "note": "all API times are the recorder's local time",
        "evidence": "candidate"
      },
      "channelBase": 1,
      "interfaces": {
        "deviceInfo": {
          "method": "GET",
          "path": "/cgi-bin/magicBox.cgi?action=getSystemInfo",
          "also": [
            "action=getMachineName",
            "action=getSoftwareVersion",
            "action=getSerialNo",
            "action=getVendor"
          ],
          "evidence": "documented"
        },
        "clock": {
          "method": "GET",
          "path": "/cgi-bin/global.cgi?action=getCurrentTime",
          "format": "result=YYYY-M-D h:m:s",
          "evidence": "documented"
        },
        "channels": {
          "method": "GET",
          "path": "/cgi-bin/configManager.cgi?action=getConfig&name=ChannelTitle",
          "count": "/cgi-bin/magicBox.cgi?action=getProductDefinition&name=MaxRemoteInputChannels",
          "remote": "/cgi-bin/configManager.cgi?action=getConfig&name=RemoteDevice (camera address per channel)",
          "evidence": "documented",
          "remoteEvidence": "candidate"
        },
        "search": {
          "method": "GET",
          "path": "/cgi-bin/mediaFileFind.cgi",
          "steps": [
            "action=factory.create -> result=<object>",
            "action=findFile&object=<object>&condition.Channel={ch}&condition.StartTime=YYYY-M-D%20h:m:s&condition.EndTime=...&condition.Types[0]=dav -> OK",
            "action=findNextFile&object=<object>&count=100 -> found=N and items[i].StartTime / EndTime / FilePath / Length / VideoStream",
            "action=close&object=<object>",
            "action=destroy&object=<object>"
          ],
          "evidence": "documented"
        },
        "storage": {
          "method": "GET",
          "path": "/cgi-bin/storageDevice.cgi?action=getDeviceAllInfo",
          "evidence": "documented"
        },
        "download": {
          "method": "GET",
          "path": "/cgi-bin/loadfile.cgi?action=startLoad&channel={ch}&startTime=YYYY-M-D%20h:m:s&endTime=...&subtype=0",
          "byName": "/cgi-bin/RPC_Loadfile/<FilePath>",
          "format": "DAV",
          "evidence": "documented"
        }
      },
      "rtsp": {
        "port": 554,
        "live": {
          "main": "/cam/realmonitor?channel={ch}&subtype=0",
          "sub": "/cam/realmonitor?channel={ch}&subtype=1",
          "evidence": "documented"
        },
        "playback": {
          "template": "/cam/playback?channel={ch}&starttime={start}&endtime={end}",
          "timeFormat": "YYYY_MM_DD_hh_mm_ss",
          "evidence": "documented"
        }
      },
      "limits": [
        "the playback URL has no documented stream selector: main stream only",
        "downloads are DAV, not MP4"
      ],
      "sources": [
        "dahua-http-api"
      ]
    },
